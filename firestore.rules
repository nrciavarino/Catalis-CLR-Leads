rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone who has actually loaded the app counts as "signed in" — the app
    // silently signs in anonymously on connect (see index.html connectFirebase()),
    // no login screen, no prompt. This exists to block bots/scripts that hit the
    // raw Firestore REST API directly without ever running the app's JS, which is
    // exactly what test-mode's wide-open rules exposed. It is NOT per-user data
    // isolation — every signed-in device can read/write everything, matching this
    // app's shared-team-data design (see README → Data model).
    function signedIn() {
      return request.auth != null;
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.name is string;
      allow delete: if signedIn();

      match /leads/{leadId} {
        allow read, create, update, delete: if signedIn();
      }

      match /attendees/{attendeeId} {
        allow read, create, update, delete: if signedIn();
      }
    }

    // Collection-group reads on "leads" (cross-event "you've met before"
    // matching, v1.11.0+). The per-path rule above does NOT cover these: a
    // collection-group query isn't tied to events/{eventId}/..., so Firestore
    // needs a rule that matches "leads" at any depth. This requires
    // rules_version = '2' (first line of this file). Read-only on purpose —
    // writes still go through the per-path rule above. See README → Setup
    // step 7 and Security notes for what this means in practice.
    match /{path=**}/leads/{leadId} {
      allow read: if signedIn();
    }

    match /meta/{docId} {
      allow read, write: if signedIn();
    }

    // Anything not explicitly matched above (there shouldn't be anything —
    // this is just a deny-by-default backstop) stays locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
